---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";

// ── "Who we work with" — three client-type sections (Figma frame 552:320).
// Desktop + tablet share the same arrangement (tablet just scales down via the
// vw-based clamps); ≤767px collapses to the single-column mobile frame (558:506),
// where the Real Estate full image is dropped (marked hideMobile).
type Media =
  | { type: "duo" | "trio"; ratio: string; images: string[]; hideMobile?: boolean }
  // mosaic = 2 images side by side on top + 1 large image below (spans both
  // columns). `images` is [top-left, top-right, big-bottom].
  | { type: "mosaic"; ratio: string; images: string[]; hideMobile?: boolean }
  | { type: "full"; ratio: string; image: string; hideMobile?: boolean };

// Exterior renders shown ABOVE the branding graphic (real-estate section).
// `grow` = the numeric aspect ratio (w/h): used as flex-grow so the two images
// share the full-bleed row at equal height, each keeping its own proportions.
type PreImg = { src: string; ratio: string; grow: number };

const sections = [
  {
    id: "real-estate",
    align: "left" as const,
    divider: false,
    heading: "Real estate developers & investors",
    sub: "Sell it before it's built.",
    body: "In Miami pre-construction, the money commits before the concrete does. Lenders, capital partners, and first buyers are all backing a space nobody can walk through yet. We close that gap. Photoreal renders, cinematic video, and immersive 360° tours let a buyer stand inside the unit before the slab is poured, while project branding and a dedicated sales site give your brokers something they can actually work with. Reservations come in sooner, and your pitch holds up when the lender starts asking questions.",
    list: [
      "Photoreal renders — exteriors, interiors, amenities",
      "Cinematic walkthrough and aerial video",
      "Immersive 360° tours for the sales center or remote investors",
      "Project naming, branding, and sales collateral",
      "A dedicated sales site and iOS sales app built to take reservations.",
    ],
    listInline: true,
    cta: "Bring us your development",
    // Native, responsive branding-value infographic (three animated stats)
    // replaces the three real-estate photos — rendered by the `graphic` branch
    // in the template below. Desktop = 3 columns, mobile = stacked.
    graphic: true,
    // Two exterior renders sit above the branding graphic, full-bleed side by side.
    preGraphic: [
      { src: "/clients/exterior1.jpg", ratio: "16 / 9", grow: 16 / 9 },
      { src: "/clients/exterior2.jpg", ratio: "4 / 5", grow: 4 / 5 },
    ] as PreImg[],
    media: [] as Media[],
  },
  {
    id: "architects",
    align: "right" as const,
    divider: true,
    heading: "Architects & general contractors",
    sub: "Win the room that can't read your plans.",
    body: "A set of drawings makes complete sense to you and almost none to the client or the board that has to sign off on it. Projects don't usually stall on the design. They stall in the meeting where the decision-maker can't picture what you're proposing. We translate your geometry, materials, and lighting into images that read the same to everyone in the room, so the architect, the builder, and the owner end up looking at one thing instead of arguing over three. Bids close faster, and you break ground without explaining the design five more times.",
    list: [
      "Design-intent renders pulled straight from your CAD",
      "Material, finish, and lighting studies, visualized",
      "Presentation imagery for boards, permits, and HOA review",
      'Immersive 360° walkthroughs that settle the "what will it look like" question.',
    ],
    listInline: true,
    cta: "Make your case visually",
    graphic: false,
    preGraphic: [] as PreImg[],
    media: [
      { type: "trio", ratio: "4 / 5", images: ["/clients/s2-trio-1.jpg", "/clients/s2-trio-2.jpg", "/clients/s2-trio-3.jpg"] },
      { type: "full", ratio: "3 / 2", image: "/clients/s2-full.jpg" },
    ] as Media[],
  },
  {
    id: "millwork",
    align: "left" as const,
    divider: true,
    heading: "Custom millwork & carpentry specialists",
    sub: "Your work is custom. Your brand should be too.",
    body: "You're doing work most contractors can't touch: joinery that outlasts the house, wood and hardware chosen down to the millimeter. And still, the client lines your quote up next to a cheap importer's, because on paper they can't tell the difference. We handle the part you don't have time for — your shop's identity, a website that looks like the work, the finished piece rendered in the client's actual room before a board gets cut. When the presentation matches the craft, price stops being the whole conversation, and the referrals start coming from the designers and developers who can tell the difference.",
    list: [
      "Workshop identity and branding",
      "A portfolio site that looks like the work",
      "The finished piece rendered in the client's actual room",
      "Visual proposals that back up a premium quote.",
    ],
    listInline: true,
    cta: "Position your workshop",
    graphic: false,
    preGraphic: [] as PreImg[],
    media: [
      { type: "mosaic", ratio: "16 / 9", images: ["/clients/bathroom1.jpg", "/clients/bathroom2.jpg", "/clients/bathroom3.jpg"] },
    ] as Media[],
  },
];
---

<Layout
  title="Who We Work With"
  description="How Borsoga Studio helps Miami real estate developers, architects, general contractors and custom millwork specialists sell and win with visualization, video and branding."
>
  <section class="clients" id="our-clients">
    <div class="cl-back">
      <BackButton />
    </div>
    <h1 class="cl-title" id="cl-title">WHO WE WORK WITH</h1>

    {
      sections.map((s) => (
        <section class:list={["cl-section", `cl-section--${s.align}`, { "cl-section--divided": s.divider }]} id={s.id}>
          {s.divider && <div class="cl-divider" />}

          <div class="cl-head">
            <div class="cl-text">
              <h2 class="cl-heading">{s.heading}</h2>
              <p class="cl-sub">{s.sub}</p>
              <p class="cl-body">{s.body}</p>
              {s.listInline ? (
                /* Figma "Who we work with": the service list reads as one
                   continuous paragraph (no bullets / line breaks), sharing the
                   body paragraph's exact line spacing. */
                <p class="cl-body">{s.list.join(" ")}</p>
              ) : (
                <ul class="cl-list">
                  {s.list.map((li) => (
                    <li>{li}</li>
                  ))}
                </ul>
              )}
            </div>
            <a href="/#contact" class="cl-cta">{s.cta}</a>
          </div>

          {s.graphic ? (
            <>
            {s.preGraphic.length > 0 && (
              /* Reduced-size exterior renders, placed above the graphic. */
              <div class="cl-exteriors">
                {s.preGraphic.map((p) => (
                  <figure
                    class="cl-fig cl-fig--ext"
                    style={`aspect-ratio:${p.ratio};flex-grow:${p.grow}`}
                  >
                    <img src={p.src} alt="" loading="lazy" decoding="async" />
                  </figure>
                ))}
              </div>
            )}
            {/* Native, responsive branding-value graphic (three animated stats).
               Desktop: 3 columns with vertical dividers. Mobile: stacked one
               below the other. Animations (count-up, bar-grow, fade-up) run on
               scroll via initBrandingGraphic() in the script below. */}
            <div class="cl-graphic" aria-label="Why branding funds the build — three key statistics">
              <div class="cl-gfx__row">
                <div class="cl-gfx__stat">
                  <p class="cl-gfx__label">Price Premium</p>
                  <div class="cl-gfx__num" data-count-to="40" data-count-prefix="+" data-count-suffix="%">+40%</div>
                  <div class="cl-gfx__bar"><span style="--fill:70%"></span></div>
                  <p class="cl-gfx__body">that a <strong>brand affiliation</strong> adds to a Miami residence vs. comparable non-branded stock. Prime global markets: 20–35%.</p>
                  <p class="cl-gfx__src">Source: Brand Atlas, 2026</p>
                </div>
                <div class="cl-gfx__stat">
                  <p class="cl-gfx__label">Pre-Sale Threshold</p>
                  <div class="cl-gfx__num" data-count-to="50" data-count-suffix="%">50%</div>
                  <div class="cl-gfx__bar"><span style="--fill:50%"></span></div>
                  <p class="cl-gfx__body">of units sold <strong>before</strong> a project secures its construction loan — financed on renders, not concrete.</p>
                  <p class="cl-gfx__src">Source: David Siddons Group</p>
                </div>
                <div class="cl-gfx__stat">
                  <p class="cl-gfx__label">Buyer Demand</p>
                  <div class="cl-gfx__num" data-count-to="4" data-count-suffix="×">4×</div>
                  <div class="cl-gfx__bar"><span style="--fill:80%"></span></div>
                  <p class="cl-gfx__body">more buyer inquiries on listings with <strong>3D tours &amp; renders</strong> vs. photo-only — faster absorption, earlier deposits.</p>
                  <p class="cl-gfx__src">Source: Transparent House, 2026</p>
                </div>
              </div>
              <p class="cl-gfx__close">Branding doesn't decorate the sale — it <span>funds the build</span>. Higher price, sold sooner, before ground breaks.</p>
            </div>
            </>
          ) : (
            s.media.map((m) => (
              <div
                class:list={[
                  "cl-media",
                  `cl-media--${m.type}`,
                  { "cl-media--hide-mobile": m.hideMobile },
                ]}
              >
                {m.type === "full" ? (
                  <figure class="cl-fig" style={`aspect-ratio:${m.ratio}`}>
                    <img src={m.image} alt="" loading="lazy" decoding="async" />
                  </figure>
                ) : (
                  m.images.map((src, idx) => (
                    <figure
                      class:list={[
                        "cl-fig",
                        { "cl-fig--mosaic-big": m.type === "mosaic" && idx === 2 },
                      ]}
                      style={`aspect-ratio:${m.ratio}`}
                    >
                      <img src={src} alt="" loading="lazy" decoding="async" />
                    </figure>
                  ))
                )}
              </div>
            ))
          )}
        </section>
      ))
    }
  </section>
</Layout>

<style>
  .clients {
    position: relative;
    background: #fff;
    color: #0a0a0a;
    font-family: "Poppins", sans-serif;
    /* Generous top margin before the heading — matches the Figma frame, where
       the title sits ~18% of the canvas width below the top (y≈454 on the
       2526-wide canvas). Root font-size is 10px, so the cap must allow ~26rem. */
    padding: clamp(14rem, 18vw, 30rem) clamp(2rem, 4vw, 6rem) clamp(5rem, 9vw, 11rem);
  }

  /* Back button — pinned top-left below the navbar, so it isn't dragged down by
     the section's large title padding. Left matches the section's side padding. */
  .cl-back {
    position: absolute;
    top: clamp(9rem, 13vh, 12rem);
    left: clamp(2rem, 4vw, 6rem);
    z-index: 2;
  }

  /* ── Page title — normal weight, with a per-character fill (Cover.astro effect) ── */
  .cl-title {
    margin: 0 0 clamp(2.5rem, 5vw, 6rem);
    font-size: clamp(3.2rem, 4vw, 7rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    /* dim until GSAP fills each character in to black */
    color: rgba(0, 0, 0, 0.19);
  }
  .cl-title .char {
    color: rgba(0, 0, 0, 0.19);
    display: inline-block;
  }
  /* Keep each word atomic so a line break never splits it mid-word. */
  .cl-title .cl-word {
    display: inline-block;
    white-space: nowrap;
  }

  /* ── Section ── */
  .cl-section {
    margin-top: clamp(4rem, 8vw, 11rem);
  }
  .cl-section:first-of-type {
    margin-top: 0;
  }
  .cl-divider {
    height: 1px;
    background: rgba(0, 0, 0, 0.18);
    margin-bottom: clamp(3rem, 6vw, 8rem);
  }

  /* ── Header: text + CTA on opposite sides, vertically centred ── */
  .cl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 7rem);
    margin-bottom: clamp(2.5rem, 5vw, 6rem);
  }
  .cl-section--right .cl-head {
    flex-direction: row-reverse;
  }
  .cl-section--right .cl-text {
    text-align: right;
  }

  .cl-text {
    flex: 0 1 62%;
    min-width: 0;
  }
  .cl-heading {
    margin: 0 0 clamp(1rem, 2vw, 2rem);
    font-size: clamp(1.9rem, 2.3vw, 3.4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .cl-sub {
    margin: 0 0 clamp(1.2rem, 2vw, 2rem);
    font-size: clamp(1.3rem, 1.5vw, 2.3rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.25;
    text-transform: uppercase;
    color: #1a1a1a;
  }
  .cl-body {
    margin: 0 0 clamp(1.2rem, 1.8vw, 2rem);
    font-size: clamp(1.15rem, 1.2vw, 1.7rem);
    font-weight: 300;
    line-height: 1.6;
    color: #2a2a2a;
  }
  .cl-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 0.5vw, 0.6rem);
  }
  .cl-list li {
    font-size: clamp(1.05rem, 1.1vw, 1.55rem);
    font-weight: 300;
    line-height: 1.5;
    /* Same near-black as the body paragraph (was a lighter grey) */
    color: #2a2a2a;
  }
  .cl-section--right .cl-list {
    align-items: flex-end;
  }

  /* CTA — black pill, hugs the opposite edge of the text */
  .cl-cta {
    flex: none;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .cl-cta:hover {
    opacity: 0.82;
  }

  /* ── Media groups ── */
  .cl-media {
    display: grid;
    gap: clamp(0.8rem, 1.6vw, 2rem);
    margin-top: clamp(1rem, 2vw, 2.4rem);
  }
  .cl-media--duo {
    grid-template-columns: 1fr 1fr;
  }
  .cl-media--trio {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .cl-media--full {
    grid-template-columns: 1fr;
  }
  /* Mosaic — two images side by side on top, one large image below (spanning
     both columns). */
  .cl-media--mosaic {
    grid-template-columns: 1fr 1fr;
  }
  .cl-fig--mosaic-big {
    grid-column: 1 / -1;
  }

  .cl-fig {
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    background: #ededed;
  }
  .cl-fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }

  /* ── Exterior renders shown above the branding graphic — a two-up mosaic that
     matches the other media groups (content width, same gap, rounded corners).
     flex-grow (set inline = each image's aspect ratio) splits the row so the
     landscape shot takes more width than the portrait, both at one shared
     height. ── */
  .cl-exteriors {
    display: flex;
    gap: clamp(0.8rem, 1.6vw, 2rem);
    margin-top: clamp(1rem, 2vw, 2.4rem);
  }
  .cl-exteriors .cl-fig--ext {
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
  }

  /* ── Branding value graphic (native, responsive) — replaces the real-estate
     photos. Desktop: 3 columns with vertical dividers. Mobile: stacked. ── */
  .cl-graphic {
    margin-top: clamp(1.5rem, 3vw, 3rem);
  }
  .cl-gfx__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.6rem, 3vw, 3.5rem);
  }
  .cl-gfx__stat {
    padding-right: clamp(1.6rem, 2.5vw, 3rem);
    border-right: 1px solid #e2e2e2;
  }
  .cl-gfx__stat:last-child {
    padding-right: 0;
    border-right: none;
  }
  .cl-gfx__label {
    margin: 0;
    font-size: clamp(0.95rem, 0.9vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9a9a9a;
  }
  .cl-gfx__num {
    margin: clamp(1rem, 1.6vw, 1.7rem) 0 0;
    font-size: clamp(4.2rem, 6.5vw, 7.4rem);
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: #111;
  }
  .cl-gfx__bar {
    margin-top: clamp(1.2rem, 1.8vw, 1.9rem);
    height: 8px;
    background: #ececec;
    border-radius: 2px;
    overflow: hidden;
  }
  .cl-gfx__bar span {
    display: block;
    height: 100%;
    width: var(--fill, 100%);
    background: #111;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left center;
  }
  .cl-gfx__body {
    margin: clamp(1.3rem, 1.8vw, 1.9rem) 0 0;
    font-size: clamp(1.15rem, 1.05vw, 1.5rem);
    font-weight: 300;
    line-height: 1.55;
    color: #555;
  }
  .cl-gfx__body strong {
    font-weight: 500;
    color: #111;
  }
  .cl-gfx__src {
    margin: clamp(0.8rem, 1vw, 1.1rem) 0 0;
    font-size: clamp(0.9rem, 0.85vw, 1.1rem);
    font-weight: 400;
    color: #9a9a9a;
  }
  .cl-gfx__close {
    margin: clamp(2.4rem, 4vw, 3.4rem) 0 0;
    padding-top: clamp(1.6rem, 2.5vw, 2.4rem);
    border-top: 1px solid #e2e2e2;
    max-width: 70ch;
    font-size: clamp(1.5rem, 1.6vw, 2.1rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    color: #333;
  }
  .cl-gfx__close span {
    font-style: normal;
    font-weight: 500;
    color: #111;
  }
  /* Reveal states — animated in by initBrandingGraphic() on scroll */
  .cl-gfx__stat,
  .cl-gfx__close {
    opacity: 0;
    transform: translateY(14px);
  }

  /* ── Entrance (same mechanism as /works/[slug].astro) ──
     Text blocks fade up on scroll (GSAP); images drift via parallax scrub. */
  .cl-head {
    opacity: 0;
    transform: translateY(24px);
  }

  /* ── TABLET (768–1024px) — same arrangement, just smaller (handled mostly by
     the vw clamps); trim the side padding a touch. ── */
  @media (min-width: 768px) and (max-width: 1024px) {
    .clients {
      padding-inline: clamp(1.6rem, 3vw, 2.6rem);
    }
    .cl-head {
      gap: clamp(1.4rem, 3vw, 2.6rem);
    }
    .cl-cta {
      font-size: 1.6rem;
      padding: 1.1rem 2.2rem;
    }
  }

  /* ── MOBILE (≤767px) — single column stack (Figma mobile frame) ── */
  @media (max-width: 767px) {
    .clients {
      padding: clamp(7rem, 16vh, 9rem) clamp(1.5rem, 6vw, 2rem) clamp(4rem, 12vw, 6rem);
    }
    /* Title padding is modest on mobile, so let the back button sit in normal
       flow above the title instead of absolutely positioned. */
    .cl-back {
      position: static;
      margin-bottom: clamp(1.4rem, 5vw, 2rem);
    }
    .cl-title {
      font-size: clamp(2.6rem, 10vw, 4rem);
      margin-top: clamp(1.5rem, 6vw, 2.5rem);
      margin-bottom: clamp(3.25rem, 12vw, 4.75rem);
    }

    /* Header stacks: text → CTA below it */
    .cl-head,
    .cl-section--right .cl-head {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(1.6rem, 5vw, 2.4rem);
    }
    .cl-text {
      flex: 1 1 auto;
    }
    .cl-heading {
      font-size: clamp(2rem, 7vw, 2.8rem);
    }
    .cl-sub {
      font-size: clamp(1.4rem, 4.6vw, 2rem);
    }
    .cl-body {
      font-size: clamp(1.1rem, 3.7vw, 1.45rem);
    }
    .cl-list li {
      font-size: clamp(1.05rem, 3.4vw, 1.35rem);
    }
    /* CTA aligns with its section's text edge */
    .cl-cta {
      align-self: flex-start;
      font-size: 1.3rem;
      padding: 0.9rem 1.9rem;
    }
    .cl-section--right .cl-cta {
      align-self: flex-end;
    }

    /* All image groups stack into one column */
    .cl-media--duo,
    .cl-media--trio,
    .cl-media--mosaic {
      grid-template-columns: 1fr;
    }
    .cl-media {
      gap: clamp(1rem, 4vw, 1.6rem);
    }
    /* Real Estate full image is dropped on mobile (matches the mobile frame) */
    .cl-media--hide-mobile {
      display: none;
    }

    /* Exterior renders — stack full-width on phones (side by side would be tiny). */
    .cl-exteriors {
      flex-direction: column;
      gap: clamp(0.8rem, 3vw, 1.2rem);
    }
    .cl-exteriors .cl-fig--ext {
      flex: none;
      width: 100%;
    }

    /* Branding graphic — stack the three stats one below the other; vertical
       dividers become horizontal, and the huge numbers scale down to fit. */
    .cl-graphic {
      /* Double the top margin on mobile (base is clamp(1.5rem, 3vw, 3rem)). */
      margin-top: clamp(3rem, 6vw, 6rem);
    }
    .cl-gfx__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .cl-gfx__stat {
      padding: clamp(1.8rem, 6vw, 2.4rem) 0;
      border-right: none;
      border-bottom: 1px solid #e2e2e2;
    }
    .cl-gfx__stat:first-child {
      padding-top: 0;
    }
    .cl-gfx__stat:last-child {
      border-bottom: none;
    }
    .cl-gfx__num {
      font-size: clamp(4rem, 17vw, 6.4rem);
    }
    .cl-gfx__label {
      font-size: clamp(0.95rem, 3vw, 1.2rem);
    }
    .cl-gfx__body {
      font-size: clamp(1.1rem, 3.7vw, 1.45rem);
    }
    .cl-gfx__close {
      max-width: none;
      font-size: clamp(1.45rem, 4.8vw, 1.9rem);
    }

    .cl-divider {
      margin-bottom: clamp(2.4rem, 9vw, 3.6rem);
    }
    .cl-section {
      margin-top: clamp(3.5rem, 12vw, 5.5rem);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // Re-runs on every navigation (astro:page-load) and tears down before each
  // swap, so it survives soft View Transitions without piling up triggers.
  let split: SplitText | null = null;

  function init(): void {
    cleanup();

    // ── Title: per-character fill — same effect as Cover.astro ──
    const title = document.getElementById("cl-title");
    if (title) {
      split = new SplitText(title, {
        type: "words,chars",
        charsClass: "char",
        wordsClass: "cl-word",
      });
      gsap.to(split.chars, {
        color: "#000",
        duration: 0.1,
        stagger: { each: 0.06, from: "start" },
        ease: "none",
        delay: 0.25,
      });
    }

    // ── Images: parallax scrub — same as /works/[slug].astro (.pd-par) ──
    document.querySelectorAll<HTMLElement>("#our-clients .cl-fig").forEach((wrap) => {
      const img = wrap.querySelector<HTMLElement>("img");
      if (!img) return;
      gsap.fromTo(
        img,
        { scale: 1.12, yPercent: -5 },
        {
          scale: 1.12,
          yPercent: 5,
          ease: "none",
          scrollTrigger: { trigger: wrap, start: "top bottom", end: "bottom top", scrub: true },
        },
      );
    });

    // ── Text blocks: fade up on scroll — same as /works/[slug].astro ──
    document.querySelectorAll<HTMLElement>("#our-clients .cl-head").forEach((el) => {
      gsap.to(el, {
        y: 0,
        opacity: 1,
        duration: 1.0,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 84%" },
      });
    });

    // ── Branding graphic: reveal stats + grow bars + count up numbers on scroll.
    const graphic = document.querySelector<HTMLElement>("#our-clients .cl-graphic");
    if (graphic) {
      const stats = gsap.utils.toArray<HTMLElement>(".cl-gfx__stat", graphic);
      const bars = gsap.utils.toArray<HTMLElement>(".cl-gfx__bar span", graphic);
      const nums = gsap.utils.toArray<HTMLElement>(".cl-gfx__num", graphic);
      const close = graphic.querySelector<HTMLElement>(".cl-gfx__close");

      const tl = gsap.timeline({
        scrollTrigger: { trigger: graphic, start: "top 78%" },
      });
      tl.to(stats, { opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: "power3.out" }, 0);
      tl.to(bars, { scaleX: 1, duration: 1.2, stagger: 0.15, ease: "power3.inOut" }, 0.2);
      if (close) tl.to(close, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0.5);

      // Count numbers up from 0 (final value stays in the markup for no-JS / SEO).
      nums.forEach((el) => {
        const to = parseFloat(el.dataset.countTo ?? "0");
        const prefix = el.dataset.countPrefix ?? "";
        const suffix = el.dataset.countSuffix ?? "";
        // Reset to 0 now (the stat is still opacity:0, so this is invisible) so
        // the final value baked into the markup — kept for no-JS / SEO — doesn't
        // flash before the count-up starts.
        el.textContent = `${prefix}0${suffix}`;
        const proxy = { v: 0 };
        tl.fromTo(
          proxy,
          { v: 0 },
          {
            v: to,
            duration: 1.4,
            ease: "power2.out",
            onUpdate: () => { el.textContent = `${prefix}${Math.round(proxy.v)}${suffix}`; },
          },
          0.25,
        );
      });
    }

    ScrollTrigger.refresh();
  }

  function cleanup(): void {
    split?.revert();
    split = null;
    // Only kill THIS page's triggers — NOT the footer's (it lives in the Layout,
    // outside #our-clients, and sets up its heading animation at module load).
    ScrollTrigger.getAll().forEach((t) => {
      const trg = t.trigger as HTMLElement | undefined;
      if (trg && trg.closest && trg.closest("#our-clients")) t.kill();
    });
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", cleanup);
</script>
