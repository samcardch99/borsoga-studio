---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
	SITE_NAME,
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_TAGLINE,
	DEFAULT_OG_IMAGE,
	CONTACT,
	SOCIAL,
	SERVICES,
} from "../consts";

interface Props {
	/** Page title. Composed as "{title} — Borsoga Studio"; omit on the home page. */
	title?: string;
	/** Meta description (~150–160 chars). Falls back to the site description. */
	description?: string;
	/** Social-share image (path from root or absolute URL). */
	image?: string;
	/** Open Graph type — "website" for listings, "article" for project pages. */
	type?: "website" | "article";
	/** Set true on experimental/duplicate pages to keep them out of the index. */
	noindex?: boolean;
	showChrome?: boolean;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	type = "website",
	noindex = false,
	showChrome = true,
} = Astro.props;

// "{Page} — Borsoga Studio", or the full brand title on the home page.
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_TITLE;

// Absolute URLs (require `site` in astro.config.mjs). Astro.site is guaranteed
// there, but guard so a missing config degrades gracefully instead of throwing.
const origin = Astro.site ?? new URL("https://borsogastudio.com");
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image, origin).href;

// ── Organization + WebSite JSON-LD (site-wide knowledge graph) ──
// Helps Google, AI Overviews and LLM answer engines understand who Borsoga is,
// what it offers, where it operates and how to reach it.
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": ["Organization", "ProfessionalService"],
			"@id": `${origin.origin}/#organization`,
			name: SITE_NAME,
			alternateName: "Borsoga",
			url: origin.origin + "/",
			logo: `${origin.origin}/favicon.svg`,
			image: ogImage,
			description: SITE_DESCRIPTION,
			slogan: SITE_TAGLINE,
			foundingDate: CONTACT.foundingYear,
			email: CONTACT.email,
			telephone: CONTACT.telephone,
			address: {
				"@type": "PostalAddress",
				addressLocality: CONTACT.city,
				addressRegion: CONTACT.region,
				addressCountry: CONTACT.country,
			},
			areaServed: CONTACT.areaServed,
			knowsAbout: SERVICES,
			keywords:
				"architectural visualization, 3D rendering, CGI, photorealistic renders, real estate visualization, immersive 360 tours, cinematic architectural video, sales websites, brand identity, Miami",
			sameAs: SOCIAL,
			// Machine-readable service list — lets AI answer engines enumerate and
			// cite exactly what the studio offers (GEO: "architectural
			// visualization services in Miami" style queries).
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: "Services",
				itemListElement: SERVICES.map((service) => ({
					"@type": "Offer",
					itemOffered: {
						"@type": "Service",
						name: service,
						serviceType: service,
						provider: { "@id": `${origin.origin}/#organization` },
						areaServed: CONTACT.areaServed,
					},
				})),
			},
			contactPoint: {
				"@type": "ContactPoint",
				contactType: "sales",
				email: CONTACT.email,
				telephone: CONTACT.telephone,
				availableLanguage: ["en", "es"],
			},
		},
		{
			"@type": "WebSite",
			"@id": `${origin.origin}/#website`,
			url: origin.origin + "/",
			name: SITE_NAME,
			description: SITE_DESCRIPTION,
			inLanguage: "en",
			publisher: { "@id": `${origin.origin}/#organization` },
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- ── Primary meta ── -->
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta
			name="robots"
			content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
		/>
		<meta name="theme-color" content="#0a0a0a" />
	<!-- Suppress Chrome/Edge's automatic translate prompt -->
	<meta name="google" content="notranslate" />

	<script is:inline>
		// In-app browsers (e.g. the Google app on iOS) render pages in a
		// WKWebView that is physically resized as the app's top/bottom bars
		// show & hide, so even the "static" svh unit behaves like dvh there
		// and full-screen sections jump while scrolling. (Safari/Chrome
		// implement their bars as UA chrome, so svh is stable in them.)
		// Freeze the viewport height into --app-height at load; sections use
		// it via `var(--app-height, 100svh)`. On touch devices only a WIDTH
		// change (rotation, real window resize) re-measures — height-only
		// resizes are exactly the bar-collapse noise we want to ignore.
		(function () {
			var lastW = window.innerWidth;
			var finePointer = window.matchMedia("(pointer: fine)").matches;
			function set() {
				document.documentElement.style.setProperty(
					"--app-height",
					window.innerHeight + "px",
				);
			}
			set();
			window.addEventListener("resize", function () {
				if (!finePointer && window.innerWidth === lastW) return;
				lastW = window.innerWidth;
				set();
			});
		})();
	</script>

		<!-- ── Open Graph ── -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_US" />

		<!-- ── Twitter / X ── -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- ── Structured data (Organization + WebSite) ── -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<!-- Page-specific structured data (BreadcrumbList, CreativeWork, …) -->
		<slot name="head" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,200;0,300;0,600;0,700&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
	</head>
	<body>
		{showChrome && <Navbar />}
		<slot />
		{showChrome && <Footer />}
	</body>
</html>

<style>
	html,
	body {
		background-color: #f7f7f7;
		margin: 0;
		width: 100%;
		/* NOT height:100% — that locks the body to one viewport tall, so content
		   overflows the box and (on iOS Safari, with its dynamic toolbars) bleeds
		   above/below the visual viewport. Let height grow with content. */
		min-height: 100%;
		/* `clip` (not `hidden`) — clips horizontal overflow WITHOUT creating a
		   scroll container, so it doesn't break `position: sticky` descendants. */
		overflow-x: clip;
	}
	/* Stop iOS Safari rubber-band overscroll from exposing content past the edges */
	html {
		overscroll-behavior-y: none;
	}
</style>

<script>
	import Lenis from "lenis";
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	declare global {
		interface Window {
			lenis: Lenis | null;
		}
	}

	gsap.registerPlugin(ScrollTrigger);

	// Mobile browsers (iOS Chrome/Safari) collapse & expand their top/bottom
	// bars while scrolling, firing height-only `resize` events. Left alone,
	// ScrollTrigger refreshes on each one — every pinned/scrubbed section
	// recalculates mid-scroll and the page visibly jumps. All sections are
	// sized in svh (static — unaffected by the bars), so those refreshes are
	// pure noise: skip them on touch devices.
	ScrollTrigger.config({ ignoreMobileResize: true });

	let lenis: Lenis | null = null;
	let rafId: number | null = null;

	function initLenis() {
		if (lenis) {
			gsap.ticker.remove(rafId as unknown as gsap.Callback);
			lenis.destroy();
			lenis = null;
			rafId = null;
		}

		lenis = new Lenis({
			duration: 1.2,
			easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			smoothWheel: true,
			wheelMultiplier: 1.2,
			touchMultiplier: 1,
			// autoRaf: false — we drive it manually via GSAP ticker
			autoRaf: false,
		});

		window.lenis = lenis;

		// Every Lenis tick → ScrollTrigger evaluates all triggers against current scrollY
		lenis.on("scroll", ScrollTrigger.update);

		// Signal to components that Lenis is ready
		(window as any).lenisReady = true;
		window.dispatchEvent(new CustomEvent("lenis:ready"));

		// GSAP ticker drives Lenis RAF
		const ticker = (time: number) => {
			lenis!.raf(time * 1000);
		};
		rafId = ticker as unknown as number;
		gsap.ticker.add(ticker);
		gsap.ticker.lagSmoothing(0);
	}

	// With <ClientRouter /> active, astro:page-load fires on the initial load
	// AND after every soft navigation — so a single listener covers both.
	// (A bare initLenis() here too would double-init and break components that
	// listen for lenis:ready with { once: true }.)
	document.addEventListener("astro:page-load", initLenis);

	// Scope soft (no-reload) View Transitions to project → project only.
	// The GSAP-heavy home & /projects pages run their scroll setup once on
	// load, so any soft navigation into/out of them would leave them broken.
	// Mark every link as a full reload EXCEPT the "next project" link.
	function markReloadLinks() {
		document
			.querySelectorAll<HTMLAnchorElement>("a[href]")
			.forEach((a) => {
				if (a.id === "pd-next-link") return; // the only soft-nav link
				a.setAttribute("data-astro-reload", "");
			});
	}
	document.addEventListener("astro:page-load", markReloadLinks);

	// ── Cross-page hash scroll (e.g. /#selected-work from the /projects "Back",
	//    or the navbar /#categories · /#contact links) ─────────────────────────
	// The homepage pins Categories via ScrollTrigger, which inserts a spacer
	// AFTER the browser's native hash jump — so the initial scroll lands on the
	// wrong section (Categories instead of the requested one). Re-scroll to the
	// real element for a short window while the pins settle, tracking it as its
	// position shifts (Lenis reads the element's live offset on each call).
	function initHashScroll() {
		const hash = window.location.hash;
		if (!hash || hash.length < 2) return;
		let target: Element | null = null;
		try {
			target = document.querySelector(hash);
		} catch {
			return; // malformed selector
		}
		if (!target) return;
		const el = target as HTMLElement;

		let frames = 0;
		function follow() {
			const l = window.lenis;
			if (l) l.scrollTo(el, { immediate: true, force: true });
			else el.scrollIntoView();
			// ~0.5s of tracking covers the pin setup + the Projects double-rAF refresh.
			if (frames++ < 32) requestAnimationFrame(follow);
		}
		requestAnimationFrame(follow);
	}
	document.addEventListener("astro:page-load", initHashScroll);
</script>
