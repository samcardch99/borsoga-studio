---
// Shared "Back" link — mirrors the .pd-back button on the project detail page
// (same size). Defaults to a true "back" to the homepage; pass `href` to point
// elsewhere. On dark backgrounds pass color="#fff" (the arrow inherits it via
// currentColor).
import RightUpArrow from "../assets/icons/right_up.svg";

interface Props {
  href?: string;
  label?: string;
  color?: string;
  class?: string;
}
const { href = "/", label = "Back", color, class: className } = Astro.props;
---

<a
  href={href}
  class:list={["back-btn", className]}
  aria-label="Back to homepage"
  style={color ? `color:${color}` : undefined}
>
  <RightUpArrow class="back-btn__arrow" aria-hidden="true" />
  <span class="back-btn__label">{label}</span>
</a>

<style>
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Poppins", sans-serif;
    font-size: clamp(1.25rem, 1.6vw, 1.95rem);
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }
  .back-btn:hover {
    opacity: 0.55;
  }
  .back-btn__arrow {
    /* right_up.svg points ↗; rotate to point ← for "back". */
    height: 1em;
    width: 1em;
    transform: rotate(-135deg);
  }

  /* Mobile + tablet (1rem = 10px): much larger type (~22px mobile → 28px
     tablet, vs 12.5px before) plus a padded hit-area (≥48px tall) so the link
     is easy to tap. Negative top/left margins cancel the padding to keep the
     label's visual position; the bottom/right padding stays uncompensated so
     the touch box gains clearance from nearby elements. */
  @media (max-width: 1024px) {
    .back-btn {
      font-size: clamp(2.2rem, 1.8rem + 1vw, 2.8rem);
      gap: 0.8rem;
      padding: 1.1rem 1.5rem;
      margin-top: -1.1rem;
      margin-left: -1.5rem;
    }
  }
</style>
