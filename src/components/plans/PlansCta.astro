---
// Closing call to action — the black band that ends every funnel page.
import { createI18n } from "../../plans/i18n";
import type { Lang } from "../../plans/config";

interface Props {
  lang: Lang;
  /** Source-language strings, translated through T(). */
  title: string;
  body: string;
  btn: string;
  href: string;
  anchor?: string;
}

const { lang, title, body, btn, href, anchor = "propuesta" } = Astro.props;
const i18n = createI18n(lang);
---

<section id={anchor} class="m-cta plans-cta" data-navbar-dark>
  <div class="plans-wrap plans-cta-inner">
    <div class="plans-cta-copy">
      <h2 class="plans-cta-title">{i18n.T(title)}</h2>
      <p class="plans-cta-body">{i18n.T(body)}</p>
    </div>
    <div class="plans-cta-action">
      <a href={href} class="btn-w plans-cta-btn">{i18n.T(btn)}</a>
    </div>
  </div>
</section>

<style>
  .plans-cta {
    background: #000;
    color: #fff;
    scroll-margin-top: var(--nav-h, 68px);
  }
  .plans-cta-inner {
    padding-top: clamp(64px, 10vw, 132px);
    padding-bottom: clamp(64px, 10vw, 132px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 72px);
    align-items: flex-end;
  }
  .plans-cta-copy {
    flex: 1 1 420px;
  }
  .plans-cta-title {
    margin: 0;
    font-size: clamp(32px, 5.6vw, 62px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 18ch;
  }
  .plans-cta-body {
    margin: clamp(20px, 3vw, 32px) 0 0;
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 300;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    max-width: 46ch;
  }
  .plans-cta-action {
    flex: 0 1 300px;
    width: 100%;
  }
  .plans-cta-btn {
    padding: 22px 32px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    width: 100%;
    display: block;
    text-align: center;
  }
</style>
