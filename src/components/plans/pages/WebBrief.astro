---
// Web design questionnaire — 10 steps — ported from the generator's `brief.page()`.
//
// The questions come from the admin panel (see src/plans/forms/index.ts);
// only ui and msg of the shared dictionary are shipped.
import PlansLayout from "../../../layouts/PlansLayout.astro";
import BriefShell from "../BriefShell.astro";
import I18nBundle from "../I18nBundle.astro";
import { route, type Lang } from "../../../plans/config";
import { createI18n } from "../../../plans/i18n";
import BriefForm from "../BriefForm.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = createI18n(lang);
---

<PlansLayout
  routeKey="webBrief"
  lang={lang}
  title={i18n.t("meta_t_brief_web")}
  description={i18n.T(
    "Cuéntanos el proyecto, el público y las funcionalidades que necesita tu sitio. Diez pasos y una propuesta escrita por una persona del estudio.",
  )}
  nav={false}
  chrome={false}
  noindex
>
  <I18nBundle lang={lang} />
  <BriefShell lang={lang} backHref={route("webDesign", lang)} />
  <BriefForm servicio="web" />
</PlansLayout>
