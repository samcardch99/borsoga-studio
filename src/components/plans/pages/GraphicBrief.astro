---
// Brand identity questionnaire — 10 steps — ported from the generator's `brief.page()`.
//
// The questions come from the admin panel (see src/plans/forms/index.ts);
// only ui and msg of the shared dictionary are shipped.
import PlansLayout from "../../../layouts/PlansLayout.astro";
import BriefShell from "../BriefShell.astro";
import I18nBundle from "../I18nBundle.astro";
import { route, type Lang } from "../../../plans/config";
import { createI18n } from "../../../plans/i18n";
import BriefForm from "../BriefForm.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = createI18n(lang);
---

<PlansLayout
  routeKey="graphicBrief"
  lang={lang}
  title={i18n.t("meta_t_brief_gd")}
  description={i18n.T(
    "Cuéntanos la marca, su público y su personalidad. Diez pasos para que la identidad se diseñe sobre lo que la empresa es, no sobre suposiciones.",
  )}
  nav={false}
  chrome={false}
  noindex
>
  <I18nBundle lang={lang} />
  <BriefShell lang={lang} backHref={route("graphicDesign", lang)} />
  <BriefForm servicio="grafico" />
</PlansLayout>
