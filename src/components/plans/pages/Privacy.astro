---
import PlansLayout from "../../../layouts/PlansLayout.astro";
import { route, type Lang } from "../../../plans/config";
import { createI18n } from "../../../plans/i18n";
import { SECTIONS, UPDATED, MAIL } from "../../../plans/privacy-content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = createI18n(lang);
const home = route("home", lang);
---

<PlansLayout
  routeKey="privacy"
  lang={lang}
  title={i18n.t("meta_t_privacidad")}
  description={i18n.T(
    "Qué información recoge Borsoga Studio, para qué la usa, con quién la comparte y qué derechos tienes sobre ella.",
  )}
  ctaHref={home}
>
  <section class="plans-wrap pv-narrow pv-hero m-hero">
    <div class="plans-eyebrow m-eyebrow pv-hero-eyebrow">{i18n.T("Legal")}</div>
    <h1 class="pv-h1">{i18n.t("chrome_privacy")}</h1>
    <p class="pv-lede">
      {
        i18n.T(
          "Este documento explica qué información nos das al usar este sitio y nuestro cuestionario, qué hacemos con ella y qué puedes pedirnos en cualquier momento. Está escrito para que se entienda, no para protegernos a nosotros.",
        )
      }
    </p>
    <p class="pv-updated">{i18n.T("Última actualización")}: {i18n.T(UPDATED)}</p>
  </section>

  <section class="plans-wrap pv-narrow pv-toc-wrap">
    <nav class="pv-toc" aria-label={i18n.T("Índice de la política")}>
      <div class="plans-eyebrow pv-toc-head">{i18n.T("En esta página")}</div>
      <ul>
        {
          SECTIONS.map((s, i) => (
            <li>
              <a href={`#s${i + 1}`} class="pv-toc-link">
                <span class="pv-toc-num">{String(i + 1).padStart(2, "0")}</span>
                {i18n.T(s.title)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <div class="plans-wrap pv-narrow pv-body">
    {
      SECTIONS.map((s, i) => (
        <section id={`s${i + 1}`} class="pv-section">
          <div class="plans-eyebrow pv-section-num">{String(i + 1).padStart(2, "0")}</div>
          <h2 class="plans-h3">{i18n.T(s.title)}</h2>
          {s.items.map((item) =>
            item.kind === "p" ? (
              <p class="plans-p" set:html={i18n.T(item.html)} />
            ) : item.kind === "h" ? (
              <div class="plans-eyebrow pv-subhead">{i18n.T(item.text)}</div>
            ) : (
              <ul class="pv-ul">
                {item.items.map((x) => (
                  <li class="pv-li">
                    <span class="pv-bullet" aria-hidden="true" />
                    {i18n.T(x)}
                  </li>
                ))}
              </ul>
            ),
          )}
        </section>
      ))
    }

    <div class="pv-contact">
      <div class="plans-eyebrow pv-toc-head">{i18n.T("Contacto")}</div>
      <h2 class="plans-h3">{i18n.T("¿Alguna duda sobre tus datos?")}</h2>
      <p class="plans-p">
        {i18n.T("Escríbenos a")}{" "}
        <a href={`mailto:${MAIL}`} class="pv-mail">{MAIL}</a>{" "}
        {i18n.T("y te respondemos. Borsoga LLC · Miami, Florida.")}
      </p>
    </div>
  </div>
</PlansLayout>

<style>
  /* A legal document reads better in a narrow measure than at the funnel's
     full 1240px. */
  .pv-narrow {
    max-width: min(100%, 860px);
  }
  .pv-hero {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(28px, 4vw, 44px);
  }
  .pv-hero-eyebrow {
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .pv-h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 62px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 16ch;
  }
  .pv-lede {
    margin: clamp(20px, 3vw, 30px) 0 0;
    font-size: 17px;
    font-weight: 300;
    line-height: 1.55;
    color: rgba(0, 0, 0, 0.65);
    max-width: 58ch;
  }
  .pv-updated {
    margin: 22px 0 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
  }
  .pv-toc-wrap {
    padding-bottom: clamp(40px, 6vw, 64px);
  }
  .pv-toc {
    border: 1px solid rgba(0, 0, 0, 0.14);
    padding: clamp(22px, 3vw, 30px);
  }
  .pv-toc-head {
    margin-bottom: 12px;
  }
  .pv-toc-link {
    font-size: 15px;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.7);
    display: block;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .pv-toc-link:hover {
    color: #000;
  }
  .pv-toc-num {
    color: rgba(0, 0, 0, 0.35);
    margin-right: 10px;
  }
  .pv-body {
    padding-bottom: clamp(20px, 3vw, 32px);
  }
  .pv-section {
    scroll-margin-top: calc(var(--nav-h, 68px) + 20px);
    padding-bottom: clamp(34px, 5vw, 52px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    margin-bottom: clamp(34px, 5vw, 52px);
  }
  .pv-section-num {
    margin-bottom: 14px;
  }
  .pv-subhead {
    margin: 26px 0 12px;
  }
  .pv-ul {
    margin: 0 0 18px;
  }
  .pv-li {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.78);
    padding: 9px 0 9px 22px;
    position: relative;
  }
  .pv-bullet {
    position: absolute;
    left: 0;
    top: 17px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
  }
  .pv-contact {
    border: 1px solid rgba(0, 0, 0, 0.14);
    padding: clamp(24px, 3vw, 34px);
  }
  .pv-mail {
    border-bottom: 1px solid rgba(0, 0, 0, 0.3);
  }
</style>
