---
// Architectural visualization configurator. Shares its shell and CSS with the
// interior design one (`quiz.py` / QuizShell): two different services, the same
// piece of interface — duplicating the styles would have meant they drifted
// apart immediately. plans-quiz-av.css carries only the deltas.
import PlansLayout from "../../../layouts/PlansLayout.astro";
import QuizShell from "../QuizShell.astro";
import I18nBundle from "../I18nBundle.astro";
import { route, type Lang } from "../../../plans/config";
import { createI18n } from "../../../plans/i18n";
import quizScript from "../../../plans/client/quiz-av.js?raw";
import "../../../styles/plans-quiz-av.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i18n = createI18n(lang);
---

<PlansLayout
  routeKey="avConfigurator"
  lang={lang}
  title={i18n.t("meta_t_quiz_av")}
  description={i18n.T("Cuéntanos las escenas que necesitas y te enviamos tu rango de inversión.")}
  nav={false}
  chrome={false}
  noindex
>
  <I18nBundle lang={lang} branches={["ui", "msg", "opt", "plural"]} />
  {/* The generator sent this back to /interior-design/ — the OTHER service's
      plans. Corrected: the AV configurator returns to the AV plans. */}
  <QuizShell lang={lang} backHref={route("avPlans", lang)} />
  {/* Bundled, not inlined: this one imports @vercel/blob/client, so it has to
      go through Vite. It only has to define window.borsogaUpload before the
      user reaches a file field, so a deferred module script is in time. */}
  <script>
    import "../../../plans/client/upload-client.js";
  </script>
  <script is:inline set:html={quizScript} />
</PlansLayout>
