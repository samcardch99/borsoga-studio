---
import { createI18n } from "../../../plans/i18n";
import type { Lang } from "../../../plans/config";
interface Props { lang: Lang; byKey?: boolean; items: readonly (readonly [string, string])[] }
const { lang, items, byKey = false } = Astro.props;
const tr = (s: string) => (byKey ? i18n.t(s) : i18n.T(s));
const i18n = createI18n(lang);
---
<div class="pl-tilegrid pl-tilegrid--wide">
  {items.map(([title, desc]) => (
    <div class="m-tile pl-cond">
      <div class="pl-cond-t">{tr(title)}</div>
      <p class="pl-cond-d">{tr(desc)}</p>
    </div>
  ))}
</div>
