---
// Ships the active language's strings to the page's client scripts, as the
// generator's bundle_i18n()/bundle_extra() did.
//
// Only ONE language is embedded — no page needs the other — and only the
// branches the page actually uses. `opt` is the questionnaire vocabulary (800+
// entries in English); without this trim the English home page carried 67 KB of
// strings it would never paint.
import { API_ORIGIN, route, type Lang } from "../../plans/config";
import esDict from "../../plans/i18n/es.js";
import enDict from "../../plans/i18n/en.js";

interface Props {
  lang: Lang;
  /** Branches to embed. The interactive pages add "opt" and "plural". */
  branches?: ("ui" | "msg" | "opt" | "plural")[];
}

const { lang, branches = ["ui", "msg"] } = Astro.props;

// The client scripts link to the privacy policy. They used to hardcode the
// generator's paths (/politica-de-privacidad/, /en/privacy-policy/), which no
// longer exist — the funnel moved under /plans/ and the languages inverted.
// Resolve it here, from the same route table the pages use.
const privacyUrl = route("privacy", lang);

const dicts: Record<Lang, any> = { es: (esDict as any).es, en: (enDict as any).en };
const d = dicts[lang];

const payload: Record<string, unknown> = { name: lang, locale: d.locale };
for (const b of branches) payload[b] = d[b];

---

<script
  is:inline
  set:html={`window.BORSOGA_LANG=${JSON.stringify(lang)};
window.BORSOGA_API=${JSON.stringify(API_ORIGIN)};
window.BORSOGA_PRIVACY=${JSON.stringify(privacyUrl)};
window.BORSOGA_I18N=Object.assign(window.BORSOGA_I18N||{},${JSON.stringify({ [lang]: payload })});`}
/>
