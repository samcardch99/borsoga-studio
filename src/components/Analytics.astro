---
// Google Analytics 4 — production only.
//
// Property "borsogastudio.com" (measurement ID below). Test deployments on
// Vercel never load it, so reviewers' visits don't count as traffic.
//
// The site navigates with Astro's ClientRouter (view transitions), so the
// automatic page_view is switched off and one is sent on every
// `astro:page-load` (which also fires on the first load).
//
// Conversions are tracked by intent, in one place, instead of wiring every
// button by hand:
//   click_call      any tel: link
//   click_whatsapp  any wa.me / api.whatsapp.com link
//   click_booking   any link to the Setmore booking page
//   click_email     any mailto: link
//   form_submit     a successful POST to the plans funnel API (/api/submit/);
//                   the footer contact form fires it itself (Form.jsx).
// Mark these five as key events in GA4 (Admin → Events).
import { IS_PREVIEW } from "../deploy-env";

const GA_ID = "G-1KNZCDT4BK";
---

{!IS_PREVIEW && (
	<>
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
		<script is:inline define:vars={{ GA_ID }}>
			if (!window.__bsgAnalytics) {
				window.__bsgAnalytics = true;
				window.dataLayer = window.dataLayer || [];
				window.gtag = function () {
					window.dataLayer.push(arguments);
				};
				gtag("js", new Date());
				gtag("config", GA_ID, { send_page_view: false });

				document.addEventListener("astro:page-load", function () {
					gtag("event", "page_view", {
						page_location: location.href,
						page_path: location.pathname,
						page_title: document.title,
					});
				});

				document.addEventListener(
					"click",
					function (e) {
						var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
						if (!a) return;
						var href = a.getAttribute("href") || "";
						var name = null;
						if (/^tel:/i.test(href)) name = "click_call";
						else if (/^mailto:/i.test(href)) name = "click_email";
						else if (/wa\.me|api\.whatsapp\.com/i.test(href)) name = "click_whatsapp";
						else if (/setmore\.com/i.test(href)) name = "click_booking";
						if (!name) return;
						gtag("event", name, {
							link_url: href,
							link_text: (a.textContent || "").trim().slice(0, 100),
							page_path: location.pathname,
							transport_type: "beacon",
						});
					},
					true,
				);

				// The plans funnel (quiz, configurators, briefs) posts leads to
				// /api/submit/. Count a form_submit only when that request succeeds.
				var nativeFetch = window.fetch;
				if (nativeFetch) {
					window.fetch = function (input, init) {
						var url = typeof input === "string" ? input : (input && input.url) || "";
						var method = ((init && init.method) || (input && input.method) || "GET").toUpperCase();
						var p = nativeFetch.apply(this, arguments);
						if (method === "POST" && url.indexOf("/api/submit/") !== -1) {
							p.then(function (res) {
								if (res && res.ok) {
									gtag("event", "form_submit", {
										form_name: location.pathname.replace(/\/+$/, "") || "/",
										page_path: location.pathname,
									});
								}
							}).catch(function () {});
						}
						return p;
					};
				}
			}
		</script>
	</>
)}
