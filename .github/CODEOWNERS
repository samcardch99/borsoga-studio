# Who has to approve a change before it reaches production.
#
# Branch protection on `main` requires an approval from a code owner of EVERY
# file a PR touches, and an approved PR is published automatically
# (workflows/aprobar.yml). So this file is the scope guard: if an AI-made change
# to a form strays into the site's code, the designer's approval no longer
# covers it and the PR waits for Sam.
#
# The last matching rule wins, so the catch-all goes first.

# Everything: Sam only.
*                              @samcardch99

# The /plans funnel — its pages, forms, texts and styles. The designer and the
# architect can publish these on their own.
# TODO: add their GitHub usernames to the three lines below.
/src/plans/                    @samcardch99
/src/components/plans/         @samcardch99
/src/styles/plans*.css         @samcardch99

# Never theirs, even inside the funnel: the API origin and the routes.
/src/plans/config.ts           @samcardch99
